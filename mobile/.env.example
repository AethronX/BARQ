# Copy to .env and fill in. Only EXPO_PUBLIC_* values belong here; they are public.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# true only for internal testing builds
EXPO_PUBLIC_TEST_LOGIN=false

# internal demo builds only
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_DEMO_BUYER=
EXPO_PUBLIC_DEMO_SUPPLIER=
EXPO_PUBLIC_DEMO_ADMIN=
